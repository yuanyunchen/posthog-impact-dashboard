{
 "n": 22,
 "columns": {
  "delivery": {
   "label": "交付估计",
   "definition": "Σ episode score (max P + 0.25 × rest) per contribution episode; deep-read P replaces tier points for sampled PRs, tier points elsewhere (review-codex R5/R8)",
   "source": "estimates.delivery_hat",
   "direction": "higher"
  },
  "major_episodes": {
   "label": "重大及以上片段数",
   "definition": "episodes containing ≥1 PR triaged major or landmark",
   "source": "estimates.major_episodes",
   "direction": "higher"
  },
  "quality_rate": {
   "label": "质量率",
   "definition": "1 − (reverted or explicitly follow-up-fixed PRs) / mature PRs triaged substantive or above (R7)",
   "source": "coarse.q",
   "direction": "higher"
  },
  "team_leverage": {
   "label": "团队杠杆",
   "definition": "human reviews given × ln(1 + distinct authors served)",
   "source": "metrics.team_leverage",
   "direction": "higher"
  },
  "requested_by": {
   "label": "被请求评审人数",
   "definition": "distinct humans who requested his review",
   "source": "team_graph",
   "direction": "higher"
  },
  "downstream_authors": {
   "label": "下游作者数",
   "definition": "distinct authors who later built on files he changed (hub files excluded)",
   "source": "team_graph",
   "direction": "higher"
  },
  "cross_team": {
   "label": "跨团队数",
   "definition": "distinct teams (team_map) of authors he approved",
   "source": "team_graph",
   "direction": "higher"
  },
  "changelog_prs": {
   "label": "changelog 数",
   "definition": "his window PRs cited in the public changelog",
   "source": "metrics.changelog_prs",
   "direction": "higher"
  },
  "ai_share": {
   "label": "AI 协作占比",
   "definition": "his PRs whose commits are Co-authored-by an AI assistant (data/commit_authors.json) / his PRs",
   "source": "metrics.ai_share",
   "direction": "neutral"
  },
  "self_driving_share": {
   "label": "AI agent 代发占比",
   "definition": "AI-agent (self-driving) PRs credited to him / his PRs",
   "source": "metrics.ai_prs / metrics.prs",
   "direction": "neutral"
  },
  "first_pass_rate": {
   "label": "首轮通过率",
   "definition": "his PRs approved with no changes requested / his reviewed PRs",
   "source": "team_graph",
   "direction": "higher"
  },
  "changes_requested_rate": {
   "label": "被要求修改率",
   "definition": "his PRs that received CHANGES_REQUESTED / his reviewed PRs",
   "source": "team_graph",
   "direction": "lower"
  },
  "trust_rank": {
   "label": "信任度",
   "definition": "PageRank on the approval graph (reviewer → author)",
   "source": "team_graph.trust_rank",
   "direction": "higher"
  },
  "importance_flow": {
   "label": "重要性回流",
   "definition": "PR points propagated over the person–PR graph to authors and substantive reviewers",
   "source": "team_graph.importance_flow",
   "direction": "higher"
  }
 },
 "percentile": "0–100 by average rank among candidates with a value (ties share the mean rank); None = unknown",
